---
import Layout from "../layouts/Layout.astro";
import { Icon } from "../components/ui/ProductIcon";
import integrateEnergyImg from "../images/capabilities/integrate_energy.png";
import smartGridImg from "../images/capabilities/smart_grid.png";
import smartManufacturingImg from "../images/capabilities/smart_manufacturing.png";
import railTransitImg from "../images/capabilities/rail_transit.png";
import energyMiningImg from "../images/capabilities/energy_mining.png";
import chemicalPharmaImg from "../images/capabilities/chemical_pharma.png";

const capabilities = [
  {
    title: "智能传感器",
    description: "研发高精度工业传感器，为工业自动化提供核心感知能力",
    features: ["温度传感器", "压力传感器", "流量传感器", "位置传感器", "视觉传感器"],
    icon: "activity",
  },
  {
    title: "工业控制器",
    description: "先进的DCS控制系统和智能控制器解决方案",
    features: ["DCS控制系统", "PLC控制器", "嵌入式控制器", "运动控制器", "远程I/O模块"],
    icon: "cpu",
  },
  {
    title: "通信设备",
    description: "支持多种工业协议的通信解决方案",
    features: ["工业以太网", "现场总线", "无线通信", "网关设备", "协议转换器"],
    icon: "network",
  },
  {
    title: "工业互联网平台",
    description: "基于大数据、云计算和AI技术的专业化平台",
    features: ["云平台搭建", "数据采集与分析", "远程监控", "预测性维护", "智能决策"],
    icon: "cloud",
  },
  {
    title: "WLG-IDE组态软件",
    description: "基于WEB的低代码编程工具，提供控制系统全生命周期管理",
    features: ["系统架构设计", "仿真调试", "系统部署", "运维监控", "AI助手集成"],
    icon: "code",
  },
  {
    title: "确定性通信DDCE",
    description: "可定义兼容确定性通信以太网技术",
    features: ["微秒级同步", "软件定义冗余", "多冗余链路", "AES/SM4加密", "TT确定性通信"],
    icon: "shield",
  },
];

const coreTechnologies = [
  { title: "DDCE确定性通信", description: "开创具有特色的兼容确定性通信可定义以太网", details: ["0.000003ms时间精度", "软件定义冗余", "多冗余链路", "支持AES/SM4加密"], icon: "shield" },
  { title: "工业交换机技术", description: "新一代工业级网络核心设备", details: ["千兆互联", "环网冗余", "透明时钟", "TT确定性通信", "<1ms自愈时间"], icon: "network" },
  { title: "PLC控制器技术", description: "高性能可编程控制器", details: ["双核240MHz/1.2GHz处理器", "16KB非易失性存储器", "WiFi4/蓝牙4.3", "IEEE-1588时间同步"], icon: "cpu" },
  { title: "WLG-IDE组态软件", description: "基于WEB的低代码编程工具，提供控制系统全生命周期管理", details: ["功能块FB设计，系统架构灵活", "集成度高，封装丰富复合功能块", "1000个观测点实时监控修改", "GPT技术集成，AI助手快捷编程"], icon: "code" },
];

const industries = [
  { name: "综合能源", description: "光伏储能接入、保护控制设备、能量管理系统EMS", icon: "sun", image: integrateEnergyImg },
  { name: "智能电网", description: "变电站自动化(IEC61850)、配电网络通信与控制", icon: "zapIcon", image: smartGridImg },
  { name: "智能制造", description: "工业机器人控制、生产线设备互联与控制", icon: "cog", image: smartManufacturingImg },
  { name: "轨道交通", description: "地铁调度控制、车载PIS网络冗余控制", icon: "train", image: railTransitImg },
  { name: "能源矿山", description: "油气管道监控、井下设备组网、风电光伏场站通信", icon: "factory", image: energyMiningImg },
  { name: "化工制药", description: "化工过程控制、制药自动化设备", icon: "flask", image: chemicalPharmaImg },
];

const processSteps = [
  { num: "1", title: "需求分析", description: "深入了解客户需求，制定详细调研计划", icon: "search" },
  { num: "2", title: "方案设计", description: "根据需求定制专业解决方案", icon: "pencil" },
  { num: "3", title: "研发实施", description: "专业团队的实施与开发", icon: "code" },
  { num: "4", title: "调试优化", description: "系统调试与性能优化", icon: "settings2" },
  { num: "5", title: "验收交付", description: "系统验收与交付培训", icon: "check" },
  { num: "6", title: "售后支持", description: "持续的技术支持与维护", icon: "lifeBuoy" },
];
---

<Layout title="能力展示">
  <section class="pt-24 pb-16 bg-gradient-to-br from-slate-900 via-slate-800 to-blue-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">能力展示</h1>
        <p class="text-xl text-slate-300 max-w-2xl mx-auto">为客户提供工业互联网全产业链的智能化解决方案</p>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-800 mb-4">核心技术能力</h2>
        <p class="text-lg text-slate-600 max-w-2xl mx-auto">依托浙江大学技术团队，拥有自主创新的核心技术优势</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {coreTechnologies.map((tech) => (
          <div class="bg-gradient-to-br from-slate-50 to-slate-100 rounded-2xl p-6 hover:shadow-xl transition-shadow duration-300">
            <div class="w-12 h-12 bg-blue-700 rounded-xl flex items-center justify-center mb-4">
              <Icon name={tech.icon as any} className="w-6 h-6 text-white" />
            </div>
            <h3 class="text-lg font-bold text-slate-800 mb-2">{tech.title}</h3>
            <p class="text-slate-600 text-sm mb-3">{tech.description}</p>
            <ul class="text-xs text-slate-500 space-y-1">
              {tech.details.map((detail) => (
                <li class="flex items-center">
                  <Icon name="check" className="w-3 h-3 text-blue-500 mr-1" />
                  {detail}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-800 mb-4">核心业务能力</h2>
        <p class="text-lg text-slate-600 max-w-2xl mx-auto">专注于工业互联网全产业链的研发与服务</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {capabilities.map((cap) => (
          <div class="bg-white rounded-2xl p-6 hover:shadow-xl transition-shadow duration-300">
            <div class="w-12 h-12 bg-blue-700 rounded-xl flex items-center justify-center mb-4">
              <Icon name={cap.icon as any} className="w-6 h-6 text-white" />
            </div>
            <h3 class="text-lg font-bold text-slate-800 mb-2">{cap.title}</h3>
            <p class="text-slate-600 text-sm mb-3">{cap.description}</p>
            <ul class="flex flex-wrap gap-2">
              {cap.features.map((feature) => (
                <li class="px-2 py-1 bg-blue-50 text-blue-700 rounded-full text-xs">{feature}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-800 mb-4">应用行业</h2>
        <p class="text-lg text-slate-600">广泛服务于多个工业领域</p>
      </div>
      <div class="grid grid-cols-2 gap-6">
        {industries.map((industry) => (
          <div class="flex flex-col bg-slate-50 rounded-xl p-6 hover:shadow-lg transition-shadow h-full">
            <div class="mb-4 flex-shrink-0">
              {industry.image ? (
                <img src={industry.image.src} alt={industry.name} class="w-full aspect-[3/2] object-cover rounded-lg" />
              ) : (
                <div class="h-40 rounded-lg flex items-center justify-center bg-gradient-to-br from-emerald-600 to-green-400">
                  <div class="text-center">
                    <svg class="w-8 h-8 text-white/70 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    <span class="text-white/70 text-xs font-medium">{industry.name} 行业图片</span>
                  </div>
                </div>
              )}
            </div>
            <div class="flex items-center gap-3 mb-2">
              <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center flex-shrink-0">
                <Icon name={industry.icon as any} className="w-5 h-5 text-blue-600" />
              </div>
              <h3 class="text-lg font-semibold text-slate-800">{industry.name}</h3>
            </div>
            <p class="text-slate-500 text-sm">{industry.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-800 mb-4">服务流程</h2>
        <p class="text-lg text-slate-600">专业的项目实施流程</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
        {processSteps.map((step) => (
          <div class="text-center bg-white rounded-xl p-4">
            <div class="w-14 h-14 bg-blue-600 rounded-full flex items-center justify-center text-white font-bold text-xl mx-auto mb-3">
              {step.num}
            </div>
            <h3 class="font-semibold text-slate-800 mb-1">{step.title}</h3>
            <p class="text-xs text-slate-500">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-800 mb-4">需要定制解决方案？</h2>
      <p class="text-xl text-slate-600 mb-8">联系我们的专业团队，获取定制化服务</p>
      <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-all duration-200">
        咨询报价
        <Icon name="arrowRight" className="w-5 h-5 ml-2 text-white" />
      </a>
    </div>
  </section>
</Layout>