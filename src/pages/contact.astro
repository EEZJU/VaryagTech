---
import Layout from '../layouts/Layout.astro';
import { COMPANY_INFO } from '../config/site';
---

<Layout title="联系我们">
  <!-- Hero Section -->
  <section class="pt-24 pb-16 bg-gradient-to-br from-slate-900 via-slate-800 to-blue-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">联系我们</h1>
        <p class="text-xl text-slate-300 max-w-2xl mx-auto">
          欢迎咨询，我们将尽快与您联系
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <!-- Contact Info -->
        <div>
          <h2 class="text-3xl font-bold text-slate-800 mb-6">联系方式</h2>
          <p class="text-lg text-slate-600 mb-8">
            任何问题或需求，请随时与我们联系。我们的专业团队将为您提供全方位的支持。
          </p>

          <div class="space-y-6">
            <div class="flex items-start">
              <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div class="ml-4">
                <h3 class="font-semibold text-slate-800">电话</h3>
                <p class="text-slate-600">{COMPANY_INFO.phone}</p>
              </div>
            </div>

            <div class="flex items-start">
              <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div class="ml-4">
                <h3 class="font-semibold text-slate-800">邮箱</h3>
                <p class="text-slate-600">{COMPANY_INFO.email}</p>
              </div>
            </div>

            <div class="flex items-start">
              <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div class="ml-4">
                <h3 class="font-semibold text-slate-800">地址</h3>
                <p class="text-slate-600">{COMPANY_INFO.address}</p>
              </div>
            </div>
          </div>

          <div class="mt-12 p-6 bg-slate-50 rounded-xl">
            <h3 class="font-semibold text-slate-800 mb-2">工作时间</h3>
            <p class="text-slate-600">周一至周五: 9:00 - 18:00</p>
            <p class="text-slate-600">周六至周日: 休息</p>
          </div>
        </div>

        <!-- RFQ Form -->
        <div class="bg-slate-50 rounded-2xl p-8">
          <h2 class="text-3xl font-bold text-slate-800 mb-6">在线询价</h2>
          <form id="rfq-form" class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label for="name" class="block text-sm font-medium text-slate-700 mb-1">
                  姓名 *
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                  placeholder="请输入您的姓名"
                />
              </div>
              <div>
                <label for="company" class="block text-sm font-medium text-slate-700 mb-1">
                  公司名称
                </label>
                <input
                  type="text"
                  id="company"
                  name="company"
                  class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                  placeholder="请输入公司名称"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label for="email" class="block text-sm font-medium text-slate-700 mb-1">
                  邮箱 *
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                  placeholder="your@email.com"
                />
              </div>
              <div>
                <label for="phone" class="block text-sm font-medium text-slate-700 mb-1">
                  电话
                </label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                  placeholder="请输入您的电话"
                />
              </div>
            </div>

            <div>
              <label for="service" class="block text-sm font-medium text-slate-700 mb-1">
                感兴趣的产品
              </label>
              <select
                id="service"
                name="service"
                class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
              >
                <option value="">请选择产品类型</option>
                <optgroup label="软件产品">
                  <option value="wlg-ide">WLG-IDE 组态软件</option>
                  <option value="agent-switch">智能体交换机控制器</option>
                  <option value="smartenergy">瓦良格能源管控平台</option>
                  <option value="security-gateway">工业安全网关软件</option>
                </optgroup>
                <optgroup label="E3系列PLC">
                  <option value="var-p-500">VAR-P-500 高端系列</option>
                  <option value="var-p-500d">VAR-P-500D 基础系列</option>
                  <option value="var-p-500u">VAR-P-500U 拓展系列</option>
                </optgroup>
                <optgroup label="X2系列PLC">
                  <option value="var-x-100">VAR-X-100 基础款</option>
                  <option value="var-x-200">VAR-X-200 运动控制版</option>
                </optgroup>
                <optgroup label="网络设备">
                  <option value="was-8-1000">WAS-8-1000 工业交换机</option>
                </optgroup>
                <option value="other">其他</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-slate-700 mb-1">
                留言 *
              </label>
              <textarea
                id="message"
                name="message"
                required
                rows="4"
                class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                placeholder="请描述您的需求..."
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full bg-blue-600 text-white font-semibold py-3 px-6 rounded-lg hover:bg-blue-700 transition-colors duration-200"
            >
              提交询价
            </button>
          </form>

          <div id="form-success" class="hidden bg-blue-100 border border-blue-400 text-blue-700 px-4 py-3 rounded-lg">
            <p class="font-semibold">感谢您的询价！</p>
            <p>请拨打我们的电话 <span class="font-semibold">{COMPANY_INFO.phone}</span> 进行详细咨询。</p>
          </div>
        </div>

        <script>
          const form = document.getElementById('rfq-form') as HTMLFormElement;
          const successMsg = document.getElementById('form-success');

          form?.addEventListener('submit', (e) => {
            e.preventDefault();
            const formData = new FormData(form);
            console.log('Form submitted:', Object.fromEntries(formData));
            form.classList.add('hidden');
            successMsg?.classList.remove('hidden');
          });
        </script>
      </div>
    </div>
  </section>

  </Layout>