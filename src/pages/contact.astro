---
import Layout from '../layouts/Layout.astro';
import { COMPANY_INFO } from '../config/site';
import RFQForm from '../components/react/RFQForm';
---

<Layout title="联系我们">
  <!-- Hero Section -->
  <section class="pt-24 pb-16 bg-gradient-to-br from-slate-900 via-slate-800 to-blue-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">联系我们</h1>
        <p class="text-xl text-slate-300 max-w-2xl mx-auto">
          欢迎咨询，我们将尽快与您联系
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <!-- Contact Info -->
        <div>
          <h2 class="text-3xl font-bold text-slate-800 mb-6">联系方式</h2>
          <p class="text-lg text-slate-600 mb-8">
            任何问题或需求，请随时与我们联系。我们的专业团队将为您提供全方位的支持。
          </p>

          <div class="space-y-6">
            <div class="flex items-start">
              <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div class="ml-4">
                <h3 class="font-semibold text-slate-800">电话</h3>
                <p class="text-slate-600">{COMPANY_INFO.phone}</p>
              </div>
            </div>

            <div class="flex items-start">
              <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div class="ml-4">
                <h3 class="font-semibold text-slate-800">邮箱</h3>
                <p class="text-slate-600">{COMPANY_INFO.email}</p>
              </div>
            </div>

            <div class="flex items-start">
              <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div class="ml-4">
                <h3 class="font-semibold text-slate-800">地址</h3>
                <p class="text-slate-600">{COMPANY_INFO.address}</p>
              </div>
            </div>
          </div>

          <div class="mt-12 p-6 bg-slate-50 rounded-xl">
            <h3 class="font-semibold text-slate-800 mb-2">工作时间</h3>
            <p class="text-slate-600">周一至周五: 9:00 - 18:00</p>
            <p class="text-slate-600">周六至周日: 休息</p>
          </div>
        </div>

        <!-- RFQ Form -->
        <div class="bg-slate-50 rounded-2xl p-8">
          <h2 class="text-3xl font-bold text-slate-800 mb-6">在线询价</h2>
          <RFQForm client:load />
        </div>
      </div>
    </div>
  </section>

  </Layout>