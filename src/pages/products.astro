---
import Layout from "../layouts/Layout.astro";
import { Icon } from "../components/ui/ProductIcon";
import VAR_P_500 from "../images/products/VAR-P-500_render.webp";
import VAR_P_500D from "../images/products/VAR-P-500D_render.webp";
import VAR_P_500U from "../images/products/VAR-P-500U_render.webp";
import VAR_X_100 from "../images/products/VAR-X-100_render.webp";
import VAR_X_200 from "../images/products/VAR-X-200_render.webp";
import WAS_8_1000_1 from "../images/products/WAS-8-1000_render.webp";
import IDE from "../images/products/IDE_render.webp";
import SDN from "../images/products/SDN_render.webp";
import VSE from "../images/products/VSE_render.webp";
import EMS from "../images/products/EMS_render.webp";
---

<Layout title="产品中心">
  <section class="pt-24 pb-16 bg-gradient-to-br from-slate-900 via-slate-800 to-blue-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">产品中心</h1>
        <p class="text-xl text-slate-300 max-w-2xl mx-auto">工控和物联网领域数智系统解决方案</p>
      </div>
    </div>
  </section>

  <!-- 软件产品 -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <div class="inline-flex items-center px-4 py-2 bg-pink-100 text-pink-700 rounded-full text-sm mb-4">软件产品</div>
        <h2 class="text-3xl md:text-4xl font-bold text-slate-800 mb-4">软件产品</h2>
        <p class="text-lg text-slate-600 max-w-2xl mx-auto">组态开发、能源管理、储能监控、网络控制等软件产品</p>
      </div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
          <img src={IDE.src} alt="WLG-IDE 组态软件" class="w-full aspect-video object-contain" />
        </div>

        <div class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
          <img src={SDN.src} alt="智能体交换机控制器" class="w-full aspect-video object-contain" />
        </div>

        <div class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
          <img src={VSE.src} alt="瓦良格能源管控平台" class="w-full aspect-video object-contain" />
        </div>

        <div class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
          <img src={EMS.src} alt="储能电站物联网平台" class="w-full aspect-video object-contain" />
        </div>
      </div>
    </div>
  </section>

  <!-- E3系列PLC -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <div class="inline-flex items-center px-4 py-2 bg-blue-100 text-blue-700 rounded-full text-sm mb-4">E3系列</div>
        <h2 class="text-3xl md:text-4xl font-bold text-slate-800 mb-4">VAR-P-500系列可编程控制器</h2>
        <p class="text-lg text-slate-600">双核240MHz处理器，强大的控制能力</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
          <img src={VAR_P_500.src} alt="VAR-P-500 高端系列可编程控制器" class="w-full aspect-video object-contain" />
        </div>

        <div class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
          <img src={VAR_P_500D.src} alt="VAR-P-500D 基础系列可编程控制器" class="w-full aspect-video object-contain" />
        </div>

        <div class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
          <img src={VAR_P_500U.src} alt="VAR-P-500U 拓展系列可编程控制器" class="w-full aspect-video object-contain" />
        </div>

        <div class="bg-slate-100 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
          <div class="aspect-video bg-gradient-to-br from-slate-300 to-slate-200 flex items-center justify-center">
            <div class="text-center">
              <svg class="w-10 h-10 text-slate-500 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"></path></svg>
              <span class="text-slate-500 text-xs font-medium">更多PLC（待扩展）</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- X2系列PLC -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <div class="inline-flex items-center px-4 py-2 bg-purple-100 text-purple-700 rounded-full text-sm mb-4">X2系列</div>
        <h2 class="text-3xl md:text-4xl font-bold text-slate-800 mb-4">VAR-X系列智能控制器</h2>
        <p class="text-lg text-slate-600">1.2GHz双核处理器，支持完整Linux系统</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
          <img src={VAR_X_100.src} alt="VAR-X-100 基础款智能控制器" class="w-full aspect-video object-contain" />
        </div>

        <div class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
          <img src={VAR_X_200.src} alt="VAR-X-200 运动控制版智能控制器" class="w-full aspect-video object-contain" />
        </div>
      </div>
    </div>
  </section>

  <!-- 网络设备 -->
  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <div class="inline-flex items-center px-4 py-2 bg-green-100 text-green-700 rounded-full text-sm mb-4">网络设备</div>
        <h2 class="text-3xl md:text-4xl font-bold text-slate-800 mb-4">工业交换机</h2>
        <p class="text-lg text-slate-600">工业级网络核心设备，千兆互联、环网冗余</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-7xl mx-auto">
        <div class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
          <img src={WAS_8_1000_1.src} alt="WAS-8-1000 工业交换机" class="w-full aspect-video object-contain" />
        </div>

        <div class="bg-slate-100 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
          <div class="aspect-video bg-gradient-to-br from-slate-300 to-slate-200 flex items-center justify-center">
            <div class="text-center">
              <svg class="w-10 h-10 text-slate-500 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"></path></svg>
              <span class="text-slate-500 text-xs font-medium">更多工业交换机（待扩展）</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-800 mb-4">了解更多产品详情</h2>
      <p class="text-xl text-slate-600 mb-8">联系我们的专业团队获取详细产品资料</p>
      <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-all duration-200">
        联系我们
        <svg class="w-5 h-5 ml-2 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
    </div>
  </section>
</Layout>