---
import Layout from '../layouts/Layout.astro';
import { COMPANY_INFO } from '../config/site';
import { Icon } from '../components/ui/ProductIcon';
---

<Layout title="关于我们">
  <section class="pt-24 pb-16 bg-gradient-to-br from-slate-900 via-slate-800 to-blue-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">关于我们</h1>
        <p class="text-xl text-slate-300 max-w-2xl mx-auto">依托浙江大学技术优势，打造工业互联网智能化解决方案</p>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl font-bold text-slate-800 mb-6">公司发展历程</h2>
          <div class="space-y-6">
            <div class="flex items-start">
              <div class="flex-shrink-0 w-12 h-12 bg-blue-700 rounded-lg flex items-center justify-center text-white font-bold">2026</div>
              <div class="ml-4">
                <h3 class="text-lg font-semibold text-slate-800">公司成立</h3>
                <p class="text-slate-600">瓦良格（杭州）智慧技术有限责任公司正式成立，扎根杭州余杭区</p>
              </div>
            </div>
            <div class="flex items-start">
              <div class="flex-shrink-0 w-12 h-12 bg-blue-700 rounded-lg flex items-center justify-center text-white font-bold">现在</div>
              <div class="ml-4">
                <h3 class="text-lg font-semibold text-slate-800">技术攻坚</h3>
                <p class="text-slate-600">依托浙大技术团队，专注工业互联网核心技术研发，推出DDCE确定性通信等创新产品</p>
              </div>
            </div>
          </div>
        </div>
        <div class="bg-slate-50 rounded-2xl p-8">
          <h3 class="text-2xl font-bold text-slate-800 mb-6">公司概览</h3>
          <dl class="grid grid-cols-1 gap-4">
            <div class="border-b border-slate-200 pb-4">
              <dt class="text-sm text-slate-500 mb-1">公司名称</dt>
              <dd class="text-lg font-semibold text-slate-800">{COMPANY_INFO.name}</dd>
            </div>
            <div class="border-b border-slate-200 pb-4">
              <dt class="text-sm text-slate-500 mb-1">成立时间</dt>
              <dd class="text-lg font-semibold text-slate-800">{COMPANY_INFO.founded}</dd>
            </div>

          </dl>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-800 mb-4">技术依托</h2>
        <p class="text-lg text-slate-600">强大的学术支持与技术后盾</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-white rounded-2xl p-8 shadow-lg">
          <div class="w-14 h-14 bg-blue-100 rounded-xl flex items-center justify-center mb-4">
            <Icon name="graduationCap" className="w-7 h-7 text-blue-600" />
          </div>
          <h3 class="text-xl font-semibold text-slate-800 mb-2">浙江大学电气学院</h3>
          <p class="text-slate-600">电气工程与自动化领域的顶尖学府</p>
        </div>
        <div class="bg-white rounded-2xl p-8 shadow-lg">
          <div class="w-14 h-14 bg-blue-100 rounded-xl flex items-center justify-center mb-4">
            <Icon name="building2" className="w-7 h-7 text-blue-600" />
          </div>
          <h3 class="text-xl font-semibold text-slate-800 mb-2">华南技术研究院</h3>
          <p class="text-slate-600">机器人与自动化研究中心</p>
        </div>
        <div class="bg-white rounded-2xl p-8 shadow-lg">
          <div class="w-14 h-14 bg-blue-100 rounded-xl flex items-center justify-center mb-4">
            <Icon name="lightbulb" className="w-7 h-7 text-blue-600" />
          </div>
          <h3 class="text-xl font-semibold text-slate-800 mb-2">浙江大学华硕实验室</h3>
          <p class="text-slate-600">前沿技术研究与实验基地</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-slate-800 mb-4">核心技术团队</h2>
        <p class="text-lg text-slate-600">来自浙江大学电气自动化的教授团队</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-2xl p-6">
          <h3 class="text-xl font-semibold text-slate-800 mb-2">DCS系统专家</h3>
          <p class="text-slate-600 mb-4">在各种DCS控制系统领域具有丰富经验</p>
          <ul class="text-sm text-slate-500 space-y-1">
            <li class="flex items-center"><Icon name="check" className="w-4 h-4 text-blue-600 mr-2" />分散控制系统设计</li>
            <li class="flex items-center"><Icon name="check" className="w-4 h-4 text-blue-600 mr-2" />系统集成与调试</li>
            <li class="flex items-center"><Icon name="check" className="w-4 h-4 text-blue-600 mr-2" />远程监控与维护</li>
          </ul>
        </div>
        <div class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-2xl p-6">
          <h3 class="text-xl font-semibold text-slate-800 mb-2">传感器技术</h3>
          <p class="text-slate-600 mb-4">专注于高精度传感器研发</p>
          <ul class="text-sm text-slate-500 space-y-1">
            <li class="flex items-center"><Icon name="check" className="w-4 h-4 text-blue-600 mr-2" />工业传感器设计</li>
            <li class="flex items-center"><Icon name="check" className="w-4 h-4 text-blue-600 mr-2" />传感算法优化</li>
            <li class="flex items-center"><Icon name="check" className="w-4 h-4 text-blue-600 mr-2" />性能测试验证</li>
          </ul>
        </div>
        <div class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-2xl p-6">
          <h3 class="text-xl font-semibold text-slate-800 mb-2">智能控制</h3>
          <p class="text-slate-600 mb-4">电力电子与智能控制技术</p>
          <ul class="text-sm text-slate-500 space-y-1">
            <li class="flex items-center"><Icon name="check" className="w-4 h-4 text-blue-600 mr-2" />智能控制算法</li>
            <li class="flex items-center"><Icon name="check" className="w-4 h-4 text-blue-600 mr-2" />电力电子技术</li>
            <li class="flex items-center"><Icon name="check" className="w-4 h-4 text-blue-600 mr-2" />节能技术方案</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</Layout>