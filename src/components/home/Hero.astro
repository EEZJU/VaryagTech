---
import { Icon } from "../ui/ProductIcon";
import { COMPANY_INFO } from "../../config/site";
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-gradient-to-br from-slate-900 via-slate-800 to-blue-900">
  <div class="absolute inset-0 bg-[url('img/grid.svg')] opacity-10"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-transparent via-transparent to-slate-900/50"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div class="inline-flex items-center px-4 py-2 bg-blue-700/20 border border-blue-500/30 rounded-full text-blue-300 text-sm mb-6">
      <span class="w-2 h-2 bg-blue-400 rounded-full mr-2 animate-pulse"></span>
      {COMPANY_INFO.certification}
    </div>

    <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold text-white mb-6 leading-tight">
      工业互联网<br />
      <span class="text-blue-400">解决方案提供商</span>
    </h1>

    <p class="text-xl md:text-2xl text-slate-300 mb-8 max-w-3xl mx-auto">
      依托浙江大学技术优势，致力于智能传感器、控制器、通信设备等的研发，构建基于工业互联网、大数据、云计算和AI技术的专业化服务平台
    </p>

    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="/capabilities" class="inline-flex items-center justify-center px-8 py-4 bg-blue-700 text-white font-semibold rounded-lg hover:bg-blue-600 transition-all duration-200">
        了解更多
        <Icon name="arrowRight" className="w-5 h-5 ml-2" />
      </a>
      <a href="/contact" class="inline-flex items-center justify-center px-8 py-4 bg-white/10 border border-white/20 text-white font-semibold rounded-lg hover:bg-white/20 transition-all duration-200">
        联系我们
      </a>
    </div>
  </div>

  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <Icon name="chevronDown" className="w-6 h-6 text-slate-400" />
  </div>
</section>